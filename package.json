{
  "name": "dimacodehub",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && npm run build:feeds",
    "build:gh": "ng build --base-href /dimacodehub/ && npm run build:feeds",
    "build:feeds": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-feeds.ts dist/dimacodehub/browser",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "ng test",
    "test:unit:coverage": "ng test --coverage",
    "test:unit:watch": "ng test --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "ng lint"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-server": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@angular/ssr": "^22.2.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.17.19",
    "@vitest/coverage-v8": "^4.1.12",
    "angular-eslint": "22.6.0",
    "eslint": "^10.13.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "^4.1.12"
  }
}
